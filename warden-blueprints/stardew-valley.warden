{
  "warden_version": "1",
  "name": "Stardew Valley",
  "meta": {
    "type": "game",
    "game_info": {
      "id": "stardew-valley",
      "executable": "Stardew Valley.exe",
      "executable_override": null,
      "version": "1.6+",
      "cover_image": "",
      "categories": ["Farming", "RPG", "Simulation"],
      "singleplayer_only": true,
      "notes": "Use these in singleplayer or offline farm sessions only. Addresses can move after restarts or patches."
    }
  },
  "premade_meta": {
    "description": "Money, health, energy, time-of-day, and selected stack count for singleplayer farms. Most values are easy one-pass scans with Warden's helper.",
    "tags": ["Farming", "RPG", "Simulation"],
    "executable": "Stardew Valley.exe",
    "notes": "Gold, time, and stack counts are straightforward exact-value scans. Health and energy work best with decreasing scans after taking damage or using tools."
  },
  "entries": [
    {
      "id": "sv-gold",
      "name": "Gold",
      "description": "Set current gold balance.",
      "category": "Farm",
      "type": "i32",
      "pointer_path": ["0x00000000"],
      "freeze": false,
      "freeze_value": 50000,
      "is_pointer": false,
      "hotkey": null,
      "toggle": false,
      "control": "stepper",
      "min": 0,
      "max": 999999999,
      "step": 1000,
      "default": 50000,
      "singleplayer_only": true,
      "wizard_hint": "exact",
      "show_value": true,
      "note": "Scan for your exact gold amount from the inventory bar."
    },
    {
      "id": "sv-health",
      "name": "Freeze Health",
      "description": "Lock player health during combat or mining.",
      "category": "Player",
      "type": "i32",
      "pointer_path": ["0x00000000"],
      "freeze": true,
      "freeze_value": 270,
      "is_pointer": false,
      "hotkey": null,
      "toggle": true,
      "control": "toggle",
      "singleplayer_only": true,
      "wizard_hint": "decreasing",
      "show_value": true,
      "note": "Take a small hit in the mines or Skull Cavern and narrow by the lower value."
    },
    {
      "id": "sv-energy",
      "name": "Freeze Energy",
      "description": "Keep stamina from dropping while chopping, mining, or fishing.",
      "category": "Player",
      "type": "i32",
      "pointer_path": ["0x00000000"],
      "freeze": true,
      "freeze_value": 270,
      "is_pointer": false,
      "hotkey": null,
      "toggle": true,
      "control": "toggle",
      "singleplayer_only": true,
      "wizard_hint": "decreasing",
      "show_value": true,
      "note": "Spend a little energy with a tool swing, then narrow using the new value."
    },
    {
      "id": "sv-time-of-day",
      "name": "Time of Day",
      "description": "Adjust the in-game clock. Stardew uses 10-minute steps like 610, 620, 630.",
      "category": "World",
      "type": "i32",
      "pointer_path": ["0x00000000"],
      "freeze": false,
      "freeze_value": 900,
      "is_pointer": false,
      "hotkey": null,
      "toggle": false,
      "control": "stepper",
      "min": 600,
      "max": 2600,
      "step": 10,
      "default": 900,
      "singleplayer_only": true,
      "wizard_hint": "exact",
      "show_value": true,
      "note": "Scan for the exact clock value shown on the HUD, then change areas or wait 10 minutes to confirm."
    },
    {
      "id": "sv-selected-stack",
      "name": "Selected Stack Count",
      "description": "Set the amount of the currently highlighted inventory stack.",
      "category": "Inventory",
      "type": "i32",
      "pointer_path": ["0x00000000"],
      "freeze": false,
      "freeze_value": 99,
      "is_pointer": false,
      "hotkey": null,
      "toggle": false,
      "control": "stepper",
      "min": 1,
      "max": 999,
      "step": 1,
      "default": 99,
      "singleplayer_only": true,
      "wizard_hint": "exact",
      "show_value": true,
      "note": "Select an item stack with a visible count, then scan for that exact integer."
    }
