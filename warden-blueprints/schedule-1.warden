  "premade_meta": {
    "description": "Cash, notoriety, stamina, active product quantity, and day timer controls for offline runs.",
    "tags": ["Simulation", "Crime", "Sandbox"],
    "executable": "Schedule1.exe",
    "notes": "Use exact scans for visible counters like cash and quantities. Use decreasing scans for stamina-like bars that tick down during sprinting or actions."
  },
  "entries": [
    {
      "id": "s1-cash",
      "name": "Cash",
      "description": "Set current cash balance.",
      "category": "Economy",
      "type": "i32",
      "pointer_path": ["0x00000000"],
      "freeze": false,
      "freeze_value": 100000,
      "is_pointer": false,
      "hotkey": null,
      "toggle": false,
      "control": "stepper",
      "min": 0,
      "max": 2000000000,
      "step": 1000,
      "default": 50000,
      "singleplayer_only": true,
      "wizard_hint": "exact",
      "show_value": true,
      "note": "Scan for the exact wallet value shown in HUD/phone UI."
    },
    {
      "id": "s1-notoriety",
      "name": "Notoriety",
      "description": "Adjust wanted/heat style notoriety level.",
      "category": "Risk",
      "type": "f32",
      "pointer_path": ["0x00000000"],
      "freeze": false,
      "freeze_value": 0.0,
      "is_pointer": false,
      "hotkey": null,
      "toggle": false,
      "control": "slider",
      "min": 0.0,
      "max": 100.0,
      "step": 0.5,
      "default": 0.0,
      "singleplayer_only": true,
      "wizard_hint": "unknown",
      "show_value": false,
      "note": "If UI is bar-only, use unknown scan then narrow while triggering and clearing police attention."
    },
    {
      "id": "s1-stamina",
      "name": "Freeze Stamina",
      "description": "Keep stamina from draining while sprinting.",
      "category": "Player",
      "type": "f32",
      "pointer_path": ["0x00000000"],
      "freeze": true,
      "freeze_value": 100.0,
      "is_pointer": false,
      "hotkey": null,
      "toggle": true,
      "control": "toggle",
      "singleplayer_only": true,
      "wizard_hint": "decreasing",
      "show_value": false,
      "note": "Sprint for a moment to reduce the bar, then scan for decreased value and freeze when found."
    },
    {
      "id": "s1-active-product-qty",
      "name": "Active Product Quantity",
      "description": "Set quantity for currently selected product stack.",
      "category": "Inventory",
      "type": "i32",
      "pointer_path": ["0x00000000"],
      "freeze": false,
      "freeze_value": 99,
      "is_pointer": false,
      "hotkey": null,
      "toggle": false,
      "control": "stepper",
      "min": 0,
      "max": 9999,
      "step": 1,
      "default": 50,
      "singleplayer_only": true,
      "wizard_hint": "exact",
      "show_value": true,
      "note": "Highlight an item with a visible quantity and scan for that exact integer."
    },
    {
      "id": "s1-day-time",
      "name": "Day Time",
      "description": "Adjust current time-of-day cycle value.",
      "category": "World",
      "type": "f32",
      "pointer_path": ["0x00000000"],
