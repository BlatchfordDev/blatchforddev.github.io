  "premade_meta": {
    "description": "Money, research, daily budget, and build speed. No anti-cheat. All addresses require a one-time scan per session — the game heap-allocates its objects.",
    "tags": ["Strategy", "Simulation"],
    "executable": "Prison Architect64.exe",
    "notes": "No anti-cheat (singleplayer only, no VAC). Verified by WeMod, FLiNG, and community CE tables. Addresses shift every session — load a save first, then use Find Address to locate each value. Research is stored as a float: 0.0 = 0%, 1.0 = 100%."
  },
  "entries": [
    {
      "id": "pa-money",
      "name": "Infinite Money",
      "description": "Lock your current cash balance. Scan for your exact money value as a float.",
      "category": "Finance",
      "type": "f32",
      "pointer_path": ["0x00000000"],
      "freeze": true,
      "freeze_value": 9999999.0,
      "is_pointer": false,
      "hotkey": null,
      "toggle": true,
      "control": "toggle",
      "singleplayer_only": true,
      "wizard_hint": "exact",
      "show_value": true
    },
    {
      "id": "pa-daily-budget",
      "name": "Freeze Daily Budget",
      "description": "Lock your daily expenditure allowance so it never drops. Scan as a float.",
      "category": "Finance",
      "type": "f32",
      "pointer_path": ["0x00000000"],
      "freeze": true,
      "freeze_value": 100000.0,
      "is_pointer": false,
      "hotkey": null,
      "toggle": true,
      "control": "toggle",
      "singleplayer_only": true,
      "wizard_hint": "exact",
      "show_value": true
    },
    {
      "id": "pa-research",
      "name": "Research Progress",
      "description": "Set research completion. Value is a float between 0.0 (0%) and 1.0 (100%). Set to 1.0 to complete instantly.",
      "category": "Progression",
      "type": "f32",
      "pointer_path": ["0x00000000"],
      "freeze": true,
      "freeze_value": 1.0,
      "is_pointer": false,
      "hotkey": null,
      "toggle": false,
      "control": "slider",
      "min": 0.0,
      "max": 1.0,
      "step": 0.05,
      "default": 1.0,
      "singleplayer_only": true,
      "wizard_hint": "increasing",
      "show_value": false,
      "note": "Scan for float 0.0 before researching, then let research tick up and narrow by the new value."
    },
    {
      "id": "pa-build-timer",
      "name": "Instant Build",
      "description": "Reduce an object's remaining build time to 0 so it completes instantly.",
      "category": "Construction",
      "type": "f32",
      "pointer_path": ["0x00000000"],
      "freeze": false,
      "freeze_value": 0.0,
      "is_pointer": false,
      "hotkey": null,
      "toggle": false,
      "control": "stepper",
      "step": 10,
      "min": 0,
      "max": 99999,
      "default": 0,
      "singleplayer_only": true,
      "wizard_hint": "decreasing",
      "show_value": false,
      "note": "Start a build and let the timer tick down slightly, then scan for the decreased value to narrow results."
    },
    {
      "id": "pa-reputation",
      "name": "Prison Reputation",
      "description": "Set prison reputation score used by grant and intake systems.",
      "category": "Progression",
      "type": "f32",
      "pointer_path": ["0x00000000"],
      "freeze": false,
      "freeze_value": 5.0,
      "is_pointer": false,
      "hotkey": null,
      "toggle": false,
      "control": "slider",
      "min": 0.0,
      "max": 10.0,
      "step": 0.1,
      "default": 5.0,
      "singleplayer_only": true,
      "wizard_hint": "unknown",
      "show_value": false,
      "note": "Scan for current reputation as float, then narrow after day tick or report change."
