{
  "warden_version": "1",
  "name": "Hades",
  "meta": {
    "type": "game",
    "game_info": {
      "id": "hades",
      "executable": "Hades.exe",
      "executable_override": null,
      "version": "1.0+",
      "cover_image": "",
      "categories": ["Action", "Roguelike"],
      "singleplayer_only": true,
      "notes": "Singleplayer only. Values can shift between runs and after patches, so use Find Address each session when needed."
    }
  },
  "premade_meta": {
    "description": "Health plus core resource currencies like Obols, Darkness, Gemstones, and Chthonic Keys for offline runs.",
    "tags": ["Action", "Roguelike"],
    "executable": "Hades.exe",
    "notes": "Currencies are visible exact-value scans. Health works best with a decreasing scan after taking damage in a chamber."
  },
  "entries": [
    {
      "id": "hd-health",
      "name": "Freeze Health",
      "description": "Lock Zagreus health during a run.",
      "category": "Player",
      "type": "i32",
      "pointer_path": ["0x00000000"],
      "freeze": true,
      "freeze_value": 100,
      "is_pointer": false,
      "hotkey": null,
      "toggle": true,
      "control": "toggle",
      "singleplayer_only": true,
      "wizard_hint": "decreasing",
      "show_value": true,
      "note": "Take a small hit from an early encounter, then narrow using the reduced health value."
    },
    {
      "id": "hd-obols",
      "name": "Obols",
      "description": "Set current Obols during a run.",
