  "premade_meta": {
    "description": "HP, FP, Stamina, Runes, and game speed. Pointer chains verified for v1.15 (Shadow of the Erdtree). All player stats resolve automatically — no scan needed.",
    "tags": ["RPG", "Soulslike"],
    "executable": "eldenring.exe",
    "notes": "Singleplayer / offline only — EAC is active in online multiplayer. Pointer chains sourced from the veeenu/eldenring-practice-tool project. If a chain fails after a patch, use Find Address to locate the new value and report it."
  },
  "entries": [
    {
      "id": "er-hp-inf",
      "name": "Freeze HP",
      "description": "Locks HP to the freeze value. Pointer chain resolves automatically.",
      "category": "Player",
      "type": "i32",
      "pointer_path": ["eldenring.exe+0x3D65F88", "0x10EF8", "0x0", "0x190", "0x0", "0x138", "0x0"],
      "freeze": true,
      "freeze_value": 2000,
      "is_pointer": true,
      "hotkey": null,
      "toggle": true,
      "control": "toggle",
      "singleplayer_only": true,
      "wizard_hint": "decreasing",
      "show_value": true
    },
    {
